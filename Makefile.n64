# Apotris N64 port (libdragon). Build with: make -f Makefile.n64
V = 1
SOURCE_DIR = .
BUILD_DIR = build
include $(N64_INST)/include/n64.mk

NAME = apotris

SRC_CPP = \
	source/audio_files.cpp source/blockEngine.cpp source/bot.cpp \
	source/descriptions.cpp source/game.cpp source/main.cpp \
	source/matchmakingQueue.cpp source/menuSystem.cpp source/menus.cpp \
	source/multiplayer.cpp source/multiplayerClasses.cpp source/music.cpp \
	source/prng.cpp source/rumblePatterns.cpp source/saving.cpp \
	source/scenario.cpp source/scene.cpp source/screenAudio.cpp \
	source/screenColorEditor.cpp source/screenControls.cpp \
	source/screenCredits.cpp source/screenException.cpp \
	source/screenGraphics.cpp source/screenHandling.cpp source/screenLinks.cpp \
	source/screenMultiplayerResults.cpp source/screenPlayOptions.cpp \
	source/screenSkinEditor.cpp source/screenTitle.cpp source/skinFile.cpp \
	source/sprites.cpp source/tetromino.cpp source/text.cpp \
	source/n64/liba_n64.cpp source/n64/ppu.cpp \
	source/n64/twoplayer.cpp
SRC_C = source/xoshiro128plusplus.c

# Binary assets converted by tools/bin2s.py into gen/*_bin.{S,h}
DATA_BINS = $(wildcard data/*.bin)
GEN_H = $(patsubst data/%.bin,gen/%_bin.h,$(DATA_BINS))
GEN_S = $(patsubst data/%.bin,gen/%_bin.S,$(DATA_BINS))

OBJS = $(SRC_CPP:%.cpp=$(BUILD_DIR)/%.o) $(SRC_C:%.c=$(BUILD_DIR)/%.o) \
	$(GEN_S:%.S=$(BUILD_DIR)/%.o)

# Extra defines, e.g. make -f Makefile.n64 APOTRIS_FLAGS=-DAPOTRIS_N64_PPU_COMPARE
APOTRIS_FLAGS ?=

N64_CXXFLAGS += $(APOTRIS_FLAGS) -DAPOTRIS_N64 -Iinclude/n64/compat -Iinclude -Idata -Igen -w -fno-exceptions
N64_CFLAGS += -DAPOTRIS_N64 -Iinclude -Igen -w
N64_ASFLAGS += -DAPOTRIS_N64

all: $(NAME).z64

$(OBJS): | gen/version.h $(GEN_H)

# Rebuild everything when APOTRIS_FLAGS changes
FLAGS_STAMP = $(BUILD_DIR)/apotris_flags.txt
$(FLAGS_STAMP): FORCE
	@mkdir -p $(BUILD_DIR)
	@echo '$(APOTRIS_FLAGS)' | cmp -s - $@ || echo '$(APOTRIS_FLAGS)' > $@
$(OBJS): $(FLAGS_STAMP)
FORCE:

gen/version.h: include/version.h.in
	@mkdir -p gen
	sed 's/@version@/4.2.0-n64/' $< > $@

# GBA assets are little-endian, swapped to the N64's byte order first
$(BUILD_DIR)/n64data/%.bin: data/%.bin tools/n64_swap.py
	@mkdir -p $(dir $@)
	python3 tools/n64_swap.py $< $@

gen/%_bin.S gen/%_bin.h: $(BUILD_DIR)/n64data/%.bin tools/bin2s.py
	@mkdir -p gen
	python3 tools/bin2s.py -a 4 -H gen/$*_bin.h $< > gen/$*_bin.S

$(BUILD_DIR)/$(NAME).elf: $(OBJS)

# --- audio, packed into the ROM filesystem (rom:/) -------------------------
#
# Sound effects: assets/*.wav, converted to wav64.
# Music: the tracker modules in assets/ and the extra songs written by
# tools/n64_tetris_music.py are rendered to audio with openmpt123 and stored
# as looping, ULC-compressed wav64 (libdragon plays no MOD or IT itself).

FS_DIR = $(BUILD_DIR)/fs
N64_MKDFS_ROOT = $(FS_DIR)

EXTRA_SONGS = GAME_g_korobeiniki GAME_h_korobeiniki_turbo GAME_i_bach_menuet
SONG_NAMES = $(basename $(notdir $(wildcard assets/*.mod assets/*.it))) $(EXTRA_SONGS)

SFX_WAV64 = $(patsubst assets/%.wav,$(FS_DIR)/sfx/%.wav64,$(wildcard assets/*.wav))
MUSIC_WAV64 = $(SONG_NAMES:%=$(FS_DIR)/music/%.wav64)

# mono 22 kHz and uncompressed: effects stream from ROM, and without a
# decoder state one effect can play on several channels at once
$(FS_DIR)/sfx/%.wav64: assets/%.wav
	@mkdir -p $(dir $@)
	$(N64_AUDIOCONV) --wav-mono --wav-resample 22050 --wav-compress 0 -o $(dir $@) $< >/dev/null

$(BUILD_DIR)/songs/extra.stamp: tools/n64_tetris_music.py assets-n64/bach-french-suite-3-menuet.mid
	python3 tools/n64_tetris_music.py assets-n64/bach-french-suite-3-menuet.mid $(BUILD_DIR)/songs
	@touch $@

$(EXTRA_SONGS:%=$(BUILD_DIR)/songs/%.mod): $(BUILD_DIR)/songs/extra.stamp

# openmpt123 names its output after its input, so render a copy without the
# extension (it recognises the format from the contents)
define render_song
	@mkdir -p $(BUILD_DIR)/render
	cp $< $(BUILD_DIR)/render/$*
	openmpt123 --quiet --render --force --samplerate 32000 --no-float $(BUILD_DIR)/render/$* >/dev/null
	rm $(BUILD_DIR)/render/$*
	python3 tools/n64_level_wav.py $@ >/dev/null
endef

$(BUILD_DIR)/render/%.wav: assets/%.mod tools/n64_level_wav.py
	$(render_song)
$(BUILD_DIR)/render/%.wav: assets/%.it tools/n64_level_wav.py
	$(render_song)
$(BUILD_DIR)/render/%.wav: $(BUILD_DIR)/songs/%.mod tools/n64_level_wav.py
	$(render_song)

$(FS_DIR)/music/%.wav64: $(BUILD_DIR)/render/%.wav
	@mkdir -p $(dir $@)
	$(N64_AUDIOCONV) --wav-compress 2 --wav-loop true -o $(dir $@) $< >/dev/null

$(BUILD_DIR)/$(NAME).dfs: $(SFX_WAV64) $(MUSIC_WAV64)

$(NAME).z64: $(BUILD_DIR)/$(NAME).dfs

$(NAME).z64: N64_ROM_TITLE = "Apotris"
# settings and records are kept in 32 KB of cartridge SRAM
$(NAME).z64: N64_ROM_SAVETYPE = sram256k

clean:
	rm -rf $(BUILD_DIR) gen $(NAME).z64

-include $(wildcard $(BUILD_DIR)/*.d) $(wildcard $(BUILD_DIR)/source/*.d)

.PHONY: all clean FORCE

# keep the swapped and generated asset files, so a rebuild does not redo them all
.SECONDARY:
